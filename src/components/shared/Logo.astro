<style>
  .navbar-logo {
    flex-shrink: 0;
    box-sizing: border-box;
    width: 5rem;
    height: 5rem;
    opacity: 1;
    margin-left: -0.5rem;
    margin-bottom: -0.5rem;
    cursor: pointer;
    pointer-events: auto;
    text-decoration: none;
    display: block;
    border-radius: 50%;
    transition: transform 0.15s;
    mix-blend-mode: darken;
  }

  @media (hover: hover) {
    .navbar-logo:hover {
      transform: scale(1.07);
    }
  }

  .navbar-logo:active {
    transform: scale(0.97);
  }

  .navbar-logo-layers {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .navbar-logo-layer {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    /* Scroll-scrubbed grow animation (needs the script above):
    animation: navbarLogoGrow 4s linear infinite;
    animation-play-state: paused;
    */
    transform: translate(-50%, -50%) scale(var(--static-scale));
    opacity: 1;
  }

  .navbar-logo-layer.layer-1 {
    /* animation-delay: 0s; */
    --static-scale: 1;
  }

  .navbar-logo-layer.layer-2 {
    /* animation-delay: -1s; */
    --static-scale: 0.7716;
  }

  .navbar-logo-layer.layer-3 {
    /* animation-delay: -2s; */
    --static-scale: 0.5954;
  }

  .navbar-logo-layer.layer-4 {
    /* animation-delay: -3s; */
    --static-scale: 0.4593;
  }

  .navbar-logo-layer img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

