---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"span">;

const { class: className, ...rest } = Astro.props;
---

<span
  class:list={[
    "rounded border-(length:--border-width) border-muted/30 bg-muted/10 px-1.5 py-0.5 text-2xs text-muted-foreground",
    className,
  ]}
  {...rest}>
  <slot />
</span>
