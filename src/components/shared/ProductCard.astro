---
import VariationPicker from "@/components/shared/VariationPicker.astro";
import type { FeedVariation } from "@/db/products/storefront";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { PUBLIC_ASSETS_BASE_URL } from "astro:env/client";

interface Props {
  title: string;
  slug: string;
  /** Paths from DB (`products.images`). Second entry is used only at `lg` + fine-pointer hover, aligned with Gallery. */
  images: string[];
  price: string | number;
  variations?: FeedVariation[];
  categorySlug: string | null;
}

const {
  title,
  slug,
  images,
  price,
  variations = [],
  categorySlug = null,
} = Astro.props;

// Sort heaviest first — mirrors the old project's display-price logic
const sortedVariations = [...variations]
  .filter((v) => v.weight > 0)
  .sort((a, b) => b.weight - a.weight);

const displayPrice = sortedVariations[0]?.price ?? price;
const priceLabel =
  typeof displayPrice === "number" ? String(displayPrice) : displayPrice;

const urls = images
  .filter(Boolean)
  .map((path) => PUBLIC_ASSETS_BASE_URL + path);
const firstUrl = urls[0] ?? null;
const secondUrl = urls[1] ?? null;
---

<div class="product-card group relative" data-category={categorySlug}>
  <div
    class="relative mb-3 aspect-square overflow-hidden bg-background"
    data-image-container
  >
    <a
      href={`/product/${slug}`}
      class="absolute inset-0 block"
      data-product-link
    >
      {
        firstUrl ? (
          <>
            <div data-image-wrapper="0" class="absolute inset-0 bg-background">
              <Image
                src={firstUrl}
                width={600}
                height={600}
                alt={title}
                loading="lazy"
                class="absolute inset-0 h-full w-full object-cover object-center"
                data-image-index="0"
              />
            </div>
            {secondUrl ? (
              <div
                data-image-wrapper="1"
                class="product-card-second-image absolute inset-0 opacity-0 bg-background group-hover:opacity-100"
              >
                <Image
                  src={secondUrl}
                  width={600}
                  height={600}
                  alt={title}
                  loading="lazy"
                  class="absolute inset-0 h-full w-full object-cover object-center"
                  data-image-index="1"
                />
              </div>
            ) : null}
          </>
        ) : (
          <div class="absolute inset-0 flex items-center justify-center">
            <Icon
              name="missingImage"
              title="Нет изображения"
              class="size-16 text-muted-foreground"
            />
          </div>
        )
      }
    </a>
  </div>

  <a href={`/product/${slug}`} class="block">
    <p>{priceLabel}</p>
    <p>{title}</p>
  </a>

  {
    sortedVariations.length > 0 && (
      <VariationPicker variations={sortedVariations} />
    )
  }
</div>

<style>
  .product-card {
    transition:
      transform 0.3s ease-out,
      box-shadow 0.3s ease-out;
  }

  .product-card-second-image {
    display: none;
  }

  @media (min-width: 1024px) and (hover: hover) {
    .product-card-second-image {
      display: block;
    }
  }

  [data-image-wrapper="1"] {
    transition: opacity 0.3s ease-out;
  }

  .product-card img {
    mix-blend-mode: darken;
    transition:
      transform 0.5s ease-out,
      opacity 0.5s ease-out;
  }

  @media (hover: hover) {
    .product-card:hover {
      z-index: 1;
      transform: scale(1.02);
      box-shadow:
        0 1px 1px hsl(0deg 0% 0% / 0.045),
        0 5px 5px hsl(0deg 0% 0% / 0.0245),
        0 10px 10px hsl(0deg 0% 0% / 0.045),
        0 15px 15px hsl(0deg 0% 0% / 0.045),
        0 20px 20px hsl(0deg 0% 0% / 0.045);
    }

    .product-card:hover img {
      transform: scale(1.05);
    }
  }
</style>
