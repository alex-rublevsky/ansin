---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { BASE_IMAGE_URL } from "@/constants";
import Badge from "../shared/Badge.astro";

const { product } = Astro.props;

const { images } = product;
---

<a href={`dashboard/product/${product.slug}`} class="productСard">
  {!product.isActive && (
    <Badge class="absolute top-2 left-2 z-10 pointer-events-none">
      Черновик
    </Badge>
  )}

  <div class="productImage">
    {
      images.length > 0 ? (
        <Image
          src={BASE_IMAGE_URL + images[0]}
          width={500}
          height={500}
          alt={product.name}
          loading="lazy"
          class="object-cover "
        />
      ) : (
        <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
          <Icon
            name="image"
            title="Нет изображения"
            class="size-16 text-muted-foreground"
          />
        </div>
      )
    }
  </div>

  <p class="text-sm">{product.name}</p>
</a>
