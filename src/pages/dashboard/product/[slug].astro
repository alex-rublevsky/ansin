---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { getProductBySlug } from "@/db/dashboard/products/productBySlug";
import AdminProductForm from "@/components/dashboard/ProductForm.astro";

const { slug } = Astro.params;

const product = await getProductBySlug(slug);

if (!product) {
  return Astro.redirect("/dashboard/product/404");
}
---

<DashboardLayout title={product.name}>
  <AdminProductForm product={product} />
</DashboardLayout>
