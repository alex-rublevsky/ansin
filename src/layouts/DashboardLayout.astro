---
import Head from "@/components/shared/Head.astro";
import DashboardNavBar from "@/components/DashboardNavBar.astro";
import { ADMIN_STOREFRONT_FLAG_KEY } from "@/constants";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Панель управления" } = Astro.props;
---

<html lang="en">
  <head>
    <Head title={title} description={description} />
  </head>

  <body>
    <DashboardNavBar />
    <slot />
    <script define:vars={{ ADMIN_STOREFRONT_FLAG_KEY }}>
      localStorage.setItem(ADMIN_STOREFRONT_FLAG_KEY, "1");
    </script>
  </body>
</html>
