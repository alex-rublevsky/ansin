---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { getDashboardProductBySlug } from "@/db/products/dashboard";
import AdminProductForm from "@/components/dashboard/ProductForm.astro";

const { slug } = Astro.params;

const detail = await getDashboardProductBySlug(slug!);

if (!detail) {
  return Astro.redirect("/dashboard");
}

const { product, variations } = detail;
---

<DashboardLayout title={product.name}>
  <section
    class="relative flex flex-col items-start gap-6 lg:flex-row lg:gap-10 pt-10"
  >
    <div class="min-w-0 lg:flex-1">
      <AdminProductForm product={product} variations={variations} />
    </div>
  </section>
</DashboardLayout>
