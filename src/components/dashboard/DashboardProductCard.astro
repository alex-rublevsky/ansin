---
import { BASE_IMAGE_URL } from "@/constants";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import Badge from "../shared/Badge.astro";

const { product } = Astro.props;

const images = product.images ?? [];
---

<a href={`/dashboard/product/${product.slug}`} class="productCard relative block">
  {!product.isActive && (
    <Badge class="absolute top-2 left-2 z-10 pointer-events-none">
      Черновик
    </Badge>
  )}

  <div class="productImage relative aspect-square">
    {
      images.length > 0 ? (
        <Image
          src={BASE_IMAGE_URL + images[0]}
          width={500}
          height={500}
          alt={product.name}
          loading="lazy"
          class="h-full w-full object-cover object-center"
        />
      ) : (
        <div class="absolute inset-0 flex items-center justify-center pointer-events-none bg-muted/20">
          <Icon
            name="image"
            title="Нет изображения"
            class="size-16 text-muted-foreground"
          />
        </div>
      )
    }
  </div>

  <p class="text-sm pt-1">{product.name}</p>
</a>
