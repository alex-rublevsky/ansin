---
import type { HTMLAttributes } from "astro/types";

type Variant = "primary" | "secondary" | "pill" | "destructive";

type Size = "default" | "xs" | "sm";

type Props = Omit<
  HTMLAttributes<"button">,
  keyof { variant?: Variant; size?: Size; href?: string }
> & {
  variant?: Variant;
  size?: Size;
  href?: string;
};

const { variant, size, href, type, class: className, ...rest } = Astro.props;

const baseClasses =
  "cursor-pointer rounded transition-colors ease-out duration-300";

const variantClasses: Record<Variant, string> = {
  primary:
    "bg-foreground text-background border border-foreground hover:bg-background hover:border hover:border-foreground hover:text-foreground",
  secondary: "",
  pill: "border border-muted-foreground bg-background rounded-full hover:bg-muted active:bg-muted-foreground active:duration-50 data-[active]:bg-foreground data-[active]:text-background data-[active]:border-foreground",
  destructive: "",
};

const sizeClasses: Record<Size, string> = {
  default: "px-4 py-2",
  sm: "px-2 py-1 text-sm",
  xs: "px-1 py-[0.5] text-sm",
  // lg: "px-5 py-3",
};

const variantClass = variantClasses[variant ?? "primary"];
const sizeClass = sizeClasses[size ?? "default"];
const composedClass = `${baseClasses}${variantClass ? ` ${variantClass}` : ""}${sizeClass ? ` ${sizeClass}` : ""}${className ? ` ${className}` : ""}`;
---

{
  href ? (
    <a href={href} class={composedClass} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type ?? "button"} class={composedClass} {...rest}>
      <slot />
    </button>
  )
}
