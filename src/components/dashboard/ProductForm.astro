---
import ImagesDropzone from "@/components/dashboard/ImagesDropzone.astro";
import MarkdownEditor from "@/components/dashboard/MarkdownEditor.astro";
import Button from "@/components/shared/Button.astro";
import Checkbox from "@/components/shared/Checkbox.astro";
import Input from "@/components/shared/Input.astro";
import Select from "@/components/shared/Select.astro";
import { getAllCategories } from "@/db/dashboard/categories/allCategories";

type ProductFormProduct = {
  id?: number;
  slug?: string;
  name?: string;
  images?: string[];
  volume?: number | null;
  cakeVolume?: number | null;
  categoryId?: number;
  description?: string | null;
  isActive?: boolean;
  variations?: any;
};
interface Props {
  product?: ProductFormProduct;
}
const { product = {} } = Astro.props as Props;

const images = product.images ?? [];

const categories = await getAllCategories();
const creating = product.slug ? false : true;
const selectedCategoryId = product.categoryId ? String(product.categoryId) : "";
---

<section>
  <form
    id="product-form"
    class="formWrapper"
    method="POST"
    data-mode={creating ? "create" : "edit"}>
    {!creating && <input type="hidden" name="id" value={product.id} />}

    <div class="productForm">
      <div class="firstColumn">
        <h1 class="text-lg pb-2">
          {creating ? "Добавление товара" : "Редактирование товара"}
        </h1>
        <ImagesDropzone images={images} />
      </div>
      <div class="infoColumn">
        <div class="textInputFields">
          <div class="nameSlug">
            <Input name="name" label="Название" value={product.name} required />
            <Input
              name="slug"
              label="Ярлык"
              value={product.slug ? product.slug : ""}
              readonly={true}
              required
            />
          </div>

          <div class="volumeInputs">
            <Input
              type="number"
              name="volume"
              value={product.volume}
              label="Объём г"
              required
            />

            <Input
              type="number"
              name="cakeVolume"
              label="Объём блина г"
              value={product.cakeVolume}
            />
          </div>
          <div class="categoryActiveInputs">
            <Select
              name="categoryId"
              label="Категория"
              placeholder="Выбрать"
              value={selectedCategoryId}
              options={categories.map((category) => ({
                value: String(category.id),
                label: category.name,
              }))}
              required
            />
            <Checkbox
              name="isActive"
              value="1"
              checked={product.isActive ?? true}>
              Товар активен
            </Checkbox>
          </div>
        </div>
        <div>
          <h5>Вариации</h5>
          <div class="variationsTableWrapper">
            <table class="variationsTable">
              <thead>
                <tr class="text-left">
                  <th>Вес г</th>
                  <th>Цена</th>
                  <th>Цена/г</th>
                </tr>
              </thead>
              <tbody>
                {
                  product.variations
                    ? product.variations.map((variation: any) => (
                        <tr class="">
                          <td>{variation.weight}</td>
                          <td class="py-1">
                            <Input
                              class="w-[12ch]!"
                              name={`variations[${variation.id}].price`}
                              value={variation.price}
                            />
                          </td>
                          <td>{variation.price / variation.weight}</td>
                        </tr>
                      ))
                    : null
                }
              </tbody>
            </table>
          </div>
        </div>
        <MarkdownEditor
          name="description"
          label="Описание"
          content={product.description ?? ""}
        />
      </div>
      <div class="fixed bottom-1.5 right-1.5 z-999">
        <Button size="sm" type="submit"
          >{creating ? "Добавить" : "Сохранить"}</Button
        >
        <Button size="sm" variant="destructive">Удалить</Button>
      </div>
    </div>
  </form>
</section>
<script>
  import { actions } from "astro:actions";
  import { generateSlug } from "@/lib/slugGeneration";

  const form = document.querySelector<HTMLFormElement>("#product-form");
  if (!form) throw Error("Форма не найдена");
  const mode = form.dataset.mode;

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const formData = new FormData(e.currentTarget as HTMLFormElement);
      const { data, error } =
        mode === "edit"
          ? await actions.product.updateProduct(formData)
          : await actions.product.createProduct(formData);

      if (error) {
        alert(error);
      } else {
        alert(data);
      }
    });

    const nameInput = form.querySelector<HTMLInputElement>('[name="name"]');
    const slugInput = form.querySelector<HTMLInputElement>('[name="slug"]');

    if (nameInput && slugInput) {
      nameInput.addEventListener("input", () => {
        slugInput.value = generateSlug(nameInput.value);
      });
    }
  }
</script>

<style>
  .formWrapper {
    margin: auto;
    padding-top: 1rem;
    padding-bottom: 4rem;
    container-type: inline-size;
    max-width: 130ch;
  }
  .productForm {
    display: grid;
    align-items: start;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin: auto;
    @container (min-width: 100ch) {
      grid-template-columns: 2fr 3fr;
    }
  }

  .infoColumn {
    padding-top: 1rem;
    display: grid;
    gap: 2.5rem;
  }

  @container (min-width: 75ch) {
    .productForm {
      grid-template-columns: 1fr 1fr;
    }
    .firstColumn {
      position: sticky;
      top: 1rem;
    }
    .infoColumn {
      padding-top: 3.8rem;
    }
  }

  .textInputFields {
    display: grid;
    gap: 0.7rem;
    container-type: inline-size;
  }

  .nameSlug {
    display: grid;
    gap: 0.7rem;
    grid-template-columns: 1fr;
    @container (min-width: 60ch) {
      grid-template-columns: 1fr 1fr;
    }
  }

  .volumeInputs {
    display: grid;
    gap: 0.7rem;
    grid-template-columns: 1fr;
    @container (min-width: 30ch) {
      grid-template-columns: 1fr 1fr;
    }
  }

  .categoryActiveInputs {
    display: grid;
    gap: 0.7rem;
    grid-template-columns: 1fr;
    @container (min-width: 37ch) {
      grid-template-columns: 1fr 1fr;
      justify-items: center;
    }
  }

  .variationsTableWrapper {
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-lg);
    padding: 0.5rem;
  }
  .variationsTable {
    width: 100%;
  }
</style>
