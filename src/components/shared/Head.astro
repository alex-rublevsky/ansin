---
import "@/styles/global.css";
import { Font } from "astro:assets";

import { BASE_IMAGE_URL, SITE_TITLE } from "@/constants";

interface Props {
  title: string;
  description: string;
  /** Absolute URL for og/twitter image. Defaults to the site banner. */
  image?: string;
}

const DEFAULT_OG_IMAGE = `${BASE_IMAGE_URL}images/sesh-full.jpg`;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image = DEFAULT_OG_IMAGE } = Astro.props;
const documentTitle = `${title} — Китайский Чай во Владивостоке`;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" href="/light.png" />
<link rel="icon" href="/favicon.ico" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="apple-mobile-web-app-title" content="Ansin" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-overused-grotesk" preload />
<Font cssVariable="--font-kazuki-reiwa" preload />
<Font cssVariable="--font-long-cang" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{documentTitle}</title>
<meta name="title" content={documentTitle} />
<meta name="description" content={description} />

<!-- TODO: Web analytics -->
<script data-goatcounter="https://rublevsky.goatcounter.com/count"
        async src="//gc.zgo.at/count.js"></script>

<!-- Open Graph -->
<meta property="og:title" content={documentTitle} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:image:alt" content={documentTitle} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="ru_RU" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={documentTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={image} />
