---
import Head from "@/components/shared/Head.astro";
import NavBar from "@/components/NavBar.astro";
import CartDrawer from "@/components/cart/CartDrawer.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Вся ваша жизнь может стать церемонией, а начало может быть положено в практике чая",
} = Astro.props;
---

<html lang="en">
  <head>
    <Head title={title} description={description} />
    <ClientRouter />
  </head>

  <body>
    <NavBar />
    <slot />
    <CartDrawer />
  </body>
</html>
