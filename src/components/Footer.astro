---
import Link from "@/components/shared/Link.astro";
import { BASE_IMAGE_URL } from "@/constants";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import Button from "./shared/Button.astro";
---

<footer class="grid grow md:grid-cols-2 bg-foreground pt-2 md:pt-12 pb-26">
  <Image
    src={BASE_IMAGE_URL + "images/sesh.webp"}
    width={1000}
    height={1000}
    alt="Фото чайной церемонии"
    class="h-auto max-h-full w-auto px-2 md:px-0 max-w-full object-contain select-none"
  />
  <div class="px-4 flex flex-col justify-evenly gap-(--step-3)">
    <div>
      <span class="font-chinese text-muted/30 text-3xl leading-none"
        >无尽的茶</span
      >
      <h4 class="max-w-[50ch] text-background! pb-6">
        Эрудиция, изучение и осмысление явлений через призму чайного мира
      </h4>

      <Button
        class="border-background! bg-background! text-foreground! hover:bg-foreground! hover:text-background!"
        href="https://t.me/Unseen_wujin_de_cha">
        Телеграм Канал
        <Icon name="telegram" title="Telegram" />
      </Button>
    </div>
    <div class="flex flex-col gap-2 self-start">
      <Link
        href="https://t.me/alexrublevsky"
        class="text-background! font-serif font-normal">
        Понравился сайт? Написать разработчику
      </Link>
    </div>
  </div>
</footer>
