---
import ImagesDropzone from "@/components/dashboard/ImagesDropzone.astro";
import Button from "@/components/shared/Button.astro";
import Checkbox from "@/components/shared/Checkbox.astro";
import { listDashboardCategories } from "@/db/dashboard/categories/listCategories";
import type { Product, ProductVariation } from "@/db/schema";
import MarkdownEditor from "../dashboard/MarkdownEditor.astro";
import Input from "../shared/Input.astro";
import Select from "../shared/Select.astro";

interface Props {
  product?: Product;
  variations?: ProductVariation[];
}

const { product, variations = [] } = Astro.props;

const name = product?.name ?? "";
const description = product?.description ?? "";
const isActive = product?.isActive ?? true;
const images = Array.isArray(product?.images) ? product.images : [];
const categoryId = product?.categoryId ?? null;
const categories = await listDashboardCategories();
const volume = product?.volume ?? 0;
const cakeVolume = product?.cakeVolume ?? 0;
const serializedVariations = JSON.stringify(
  variations.map((variation) => ({
    weight: variation.weight,
    price: variation.price,
  })),
);
---

<div class="grid md:grid-cols-2 gap-6">
  <ImagesDropzone images={images} productId={product?.id} />

  <form
    class="flex flex-col gap-(--fluid-sm)"
    x-data="productForm()"
    x-on:submit.prevent="save"
    data-product-id={product?.id?.toString() ?? ""}
    data-variations={serializedVariations}
  >
    <p
      class="rounded-md border border-destructive/30 bg-destructive/10 p-3 text-sm text-destructive"
      x-show="errors.form"
      x-text="errors.form"
      x-cloak
      role="alert"
    >
    </p>

    <div class="grid grid-cols-2 gap-(--fluid-2xs)">
      <div>
        <Input
          type="text"
          name="name"
          value={name}
          label="Название"
          required
          {...{ "x-model": "name" } as any}
        />
        <p
          class="mt-1 text-xs font-medium text-destructive"
          x-show="errors.name"
          x-text="errors.name"
          x-cloak
        >
        </p>
      </div>

      <div>
        <Select
          name="categoryId"
          label="Категория"
          placeholder="Выберите категорию"
          value={categoryId === null ? "" : String(categoryId)}
          options={categories.map((category) => ({
            value: String(category.id),
            label: category.name,
          }))}
          {...{ "x-model": "categoryId" } as any}
        />
        <p
          class="mt-1 text-xs font-medium text-destructive"
          x-show="errors.categoryId"
          x-text="errors.categoryId"
          x-cloak
        >
        </p>
      </div>
    </div>
    <MarkdownEditor name="description" content={description} label="Описание" />
    <p
      class="text-xs font-medium text-destructive"
      x-show="errors.description"
      x-text="errors.description"
      x-cloak
    >
    </p>

    <div class="grid grid-cols-2 gap-(--fluid-2xs)">
      <div>
        <Input
          type="number"
          name="volume"
          value={volume.toString()}
          label="Объём г"
          {...{ "x-model.number": "volume" } as any}
        />
        <p
          class="mt-1 text-xs font-medium text-destructive"
          x-show="errors.volume"
          x-text="errors.volume"
          x-cloak
        >
        </p>
      </div>

      <div>
        <Input
          type="number"
          name="cakeVolume"
          value={cakeVolume.toString()}
          label="Объём блина г"
          {...{ "x-model.number": "cakeVolume" } as any}
        />
        <p
          class="mt-1 text-xs font-medium text-destructive"
          x-show="errors.cakeVolume"
          x-text="errors.cakeVolume"
          x-cloak
        >
        </p>
      </div>
    </div>

    <Checkbox
      name="isActive"
      value="1"
      checked={isActive}
      {...{ "x-model": "isActive" } as any}
    >
      Товар активен
    </Checkbox>

    <section x-show="needsVariations" x-cloak>
      <div class="mb-2">
        <h5>Вариации</h5>
      </div>
      <div
        class="overflow-hidden overflow-x-auto rounded-lg border border-border"
      >
        <table class="w-full text-sm">
          <thead>
            <tr>
              <th class="px-3 py-2 text-left font-medium text-muted-foreground">
                Вес
              </th>
              <th
                class="px-3 py-2 text-right font-medium text-muted-foreground"
              >
                Цена
              </th>
              <th
                class="px-3 py-2 text-right text-xs font-medium text-muted-foreground"
              >
                ₽/г
              </th>
            </tr>
          </thead>
          <tbody>
            <template x-for="weight in weightSteps" :key="weight">
              <tr class="border-t border-border">
                <td class="px-3 py-1.5" x-text="weight + ' г'"></td>
                <td class="px-3 py-1.5 text-right">
                  <input
                    type="number"
                    min="0"
                    step="1"
                    placeholder="0"
                    class="w-24 rounded border border-border bg-background px-2 py-0.5 text-right text-sm focus:border-foreground focus:outline-none"
                    x-model.number="priceByWeight[weight]"
                    x-on:input="clearError('variations')"
                  />
                </td>
                <td
                  class="px-3 py-1.5 text-right text-xs tabular-nums text-muted-foreground"
                  x-text="pricePerGram(weight)"
                >
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
      <p
        class="mt-1 text-xs font-medium text-destructive"
        x-show="errors.variations"
        x-text="errors.variations"
        x-cloak
      >
      </p>
    </section>

    <div class="flex flex-wrap gap-2">
      <Button
        type="submit"
        {...{ ":disabled": "saveState === 'loading'" } as any}
      >
        <span x-text="saveLabel">Сохранить</span>
      </Button>
      {
        product && (
          <Button
            type="button"
            variant="destructive"
            {...({
              "x-on:click": "deleteProduct",
              ":disabled": "deleteState === 'loading'",
            } as any)}
          >
            <span x-text="deleteLabel">Удалить товар</span>
          </Button>
        )
      }
    </div>
  </form>
</div>
