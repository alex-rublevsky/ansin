---
interface Props {
  name?: string;
  value?: string;
  disabled?: boolean;
  checked?: boolean;
}

const { name, value, disabled, checked, ...rest } = Astro.props;
---

<label class="checkbox-wrapper">
  <input
    type="checkbox"
    name={name}
    value={value}
    checked={checked}
    disabled={disabled}
    class="checkbox-input"
    {...rest}
  />
  <span class="checkbox-check" aria-hidden="true">
    <span class="checkbox-fill">
      <svg
        viewBox="0 0 16 12"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        role="img"
        aria-label="Checkmark"
      >
        <path
          d="M2 6L6 10L14 2"
          pathLength="1"
          stroke-dasharray="1"
          stroke="var(--background)"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
  </span>
  <slot />
</label>

<style>
  .checkbox-wrapper {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    user-select: none;
    position: relative;
  }

  .checkbox-wrapper:has(.checkbox-input:disabled) :global(*) {
    cursor: not-allowed;
  }

  /* Visually hidden — keeps native behavior (keyboard, form submission) */
  .checkbox-input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    outline: none;
  }

  .checkbox-check {
    --border-radius: 6px;
    --border-width: 2px;
    --outline-offset: 3px;
    --outline-width: 2px;
    --initial-scale: 0.5;
    /* prettier-ignore */
    --fill-spring: linear(
        0,
        0.0033 0.81%,  0.027 2.42%,   0.0916 4.84%,
        0.4745 15.32%, 0.6422 20.97%, 0.7175,
        0.7789,        0.8283 30.64%, 0.876,
        0.9111 38.71%, 0.941,         0.9611 48.39%,
        0.9707,        0.978 54.84%,  0.9885 62.1%,
        0.9949 70.97%, 0.9982 82.26%, 0.9997 100%
      ) 0.498s;

    display: block;
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    position: relative;
    border-radius: var(--border-radius);
  }

  /* The border ring — fades up on hover/checked */
  .checkbox-check::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: var(--border-width) solid var(--foreground);
    opacity: 0.3;
    transition: opacity 0.2s ease;
  }

  /* The fill square that springs into view */
  .checkbox-fill {
    background: var(--foreground);
    border-radius: inherit;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity ease 0.2s;
  }

  @media (prefers-reduced-motion: no-preference) {
    .checkbox-fill {
      scale: var(--initial-scale);
      transition:
        opacity ease 0.2s,
        scale var(--fill-spring);
    }
  }

  .checkbox-fill svg {
    width: auto;
    height: 0.6rem;
  }

  /* Checkmark stroke draws in after the fill lands */
  @media (prefers-reduced-motion: no-preference) {
    .checkbox-fill svg path {
      /* prettier-ignore */
      transition: stroke-dashoffset
        linear(
          0,
          0.0089 1.34%,  0.0665 4.01%,  0.4534 14.71%,
          0.6529 21.39%, 0.7147 24.06%, 0.7899 28.08%,
          0.8297 30.75%, 0.8768,         0.9116 38.77%,
          0.9438,        0.9646,         0.9779 54.81%,
          0.9879 61.5%,  0.9948 70.86%, 0.9981 81.55%,
          0.9996 98.93%
        )
        0.3868s;
      stroke-dashoffset: 1;
    }
  }

  /* ── Checked ────────────────────────────────────────────── */

  /* Slightly raise border opacity when checked (without focus ring) */
  .checkbox-input:checked:not(:focus-visible) + .checkbox-check::before {
    opacity: 0.5;
  }

  .checkbox-input:checked + .checkbox-check .checkbox-fill {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .checkbox-input:checked + .checkbox-check .checkbox-fill {
      scale: 1;
    }

    /* Small delay so the stroke starts after the fill has popped */
    .checkbox-input:checked + .checkbox-check .checkbox-fill path {
      stroke-dashoffset: 0;
      transition-delay: 33ms;
    }
  }

  /* ── Disabled ───────────────────────────────────────────── */

  .checkbox-input:disabled + .checkbox-check {
    opacity: 0.5;
  }

  .checkbox-wrapper:has(.checkbox-input:disabled) {
    cursor: not-allowed;
  }

  /* ── Focus ring ─────────────────────────────────────────── */

  .checkbox-input:focus-visible + .checkbox-check {
    box-shadow:
      0 0 0 var(--outline-offset) var(--background),
      0 0 0 calc(var(--outline-offset) + var(--outline-width)) var(--foreground);
  }

  /* Kill transitions during keyboard nav for instant response */
  .checkbox-input:focus-visible + .checkbox-check,
  .checkbox-input:focus-visible + .checkbox-check * {
    transition: none;
  }

  /* ── Hover ──────────────────────────────────────────────── */

  .checkbox-wrapper:hover .checkbox-check::before {
    opacity: 0.5;
  }
</style>
