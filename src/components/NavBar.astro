---
import CartButton from "@/components/CartButton.astro";
import CategoryFilter from "@/components/CategoryFilter.astro";
import Logo from "@/components/shared/Logo.astro";
const isHomePage = Astro.url.pathname === "/";
---

<nav
  class:list={[
    "site-nav fixed bottom-1.5 left-1.5 right-1.5 z-999 flex items-end justify-between gap-3xs",
    isHomePage ? "flex-col-reverse md:flex-row" : "flex-row",
  ]}>
  <div class:list={["min-w-0 flex-1 self-end", !isHomePage && "hidden"]}>
    <CategoryFilter />
  </div>
  <div class:list={[isHomePage && "hidden"]}>
    <Logo />
  </div>

  <div class="shrink-0">
    <CartButton />
  </div>
</nav>
