---
import { getActiveCategories } from "@/db/categories";
import Button from "@/components/shared/Button.astro";

const categories = await getActiveCategories();

const selected = Astro.url.searchParams.get("category") ?? "all";

const items = [
  { label: "Все", value: "all", active: selected === "all" },
  ...categories.map((cat) => ({
    label: cat.name,
    value: cat.slug,
    active: selected === cat.slug,
  })),
];
---

{
  categories.length > 0 &&
    items.map((cat) => (
      <Button
        size="sm"
        variant="pill"
        data-category={cat.value}
        data-category-button
      >
        {cat.label}
      </Button>
    ))
}
