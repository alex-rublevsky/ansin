---
import { BASE_IMAGE_URL } from "@/constants";
import { Image } from "astro:assets";
import ImageTile from "@/components/dashboard/ImageTile.astro";

const { images } = Astro.props;
---

<div id="drop-area" data-initial-images={JSON.stringify(images)}>
  <div id="gallery">
    {
      images.map((image: string) => (
        <ImageTile path={image} status="ready">
          <Image
            src={`${BASE_IMAGE_URL}${image}`}
            alt=""
            width={300}
            height={300}
            data-role="preview"
          />
        </ImageTile>
      ))
    }

    <label id="add-photo-button" for="image_uploads" class="addItemEntry">
      <span class="plus">+</span>
      <span>Добавить фото</span>
    </label>

    <input
      hidden
      class="addItemEntry"
      type="file"
      id="image_uploads"
      multiple
      accept="image/*"
    />
  </div>

  <label class="text-sm text-center text-muted pt-2 pb-1 select-none"
    >Фотки можно перетащить сюда</label
  >
</div>

<template id="image-tile-template">
  <ImageTile>
    <img alt="" data-role="preview" />
  </ImageTile>
</template>

<style>
  #drop-area {
    display: flex;
    flex-direction: column;
    border: var(--border-width) dashed var(--border);
    /*border-radius: var(--radius-lg);*/
    width: 100%;
    padding: 0.4rem;
  }

  #drop-area.highlight {
    border-color: purple;
  }

  #gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(6rem, 1fr));
    gap: 0.5rem;
  }

  .addItemEntry {
    width: 100%;
    aspect-ratio: 1;
    user-select: none;
    padding: 0.2rem;
    text-align: center;
    line-height: 1;
    display: flex;
    gap: 1rem;
    font-size: var(--step--1);
    flex-direction: column;
    justify-content: center;
    align-items: center;
    border: var(--border-width) dashed var(--border);
    cursor: pointer;
    transition:
      border-color 170ms,
      transform 170ms;
  }

  .addItemEntry:hover {
    border-color: var(--primary);
  }
  .addItemEntry:active {
    transform: scale(0.97);
  }

  .addItemEntry .plus {
    font-size: var(--step-2);
    font-weight: 100;
    line-height: 0;
    color: var(--muted);
    transition:
      transform 170ms ease-out,
      color 170ms ease-out;
  }

  .addItemEntry:hover .plus {
    transform: scale(1.15);
    color: var(--foreground);
  }
</style>

<script>
  import "@/lib/dropzone-gallery";
</script>
