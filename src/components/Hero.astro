---
import Logo from "@/components/shared/Logo.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "@/constants";
---

<section
  class="pt-4 lg:pt-10 pb-16 ml-4 lg:ml-10 flex items-center gap-s lg:gap-xl">
  <Logo large />
  <div class="flex flex-col items-start">
    <h1 class="text-left pb-1" data-hero-title>{SITE_TITLE}</h1>
    <p
      class="max-w-[35ch] text-foreground-muted font-serif sm:text-sm md:text-md font-bold md:font-normal leading-[1.05]"
      data-hero-desc>
      {SITE_DESCRIPTION}
    </p>
  </div>
</section>
