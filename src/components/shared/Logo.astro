---
// Scroll-driven navbar logo, ported from `ansin 0.5`.
const { large } = Astro.props;
---

<a href="/" class={`navbar-logo ${large ? `scale-180` : "scale-80"}`} aria-label="Home">
  <div class="navbar-logo-layers" id="scroll-logo-layers">
    <div class="navbar-logo-layer layer-1">
      <img src="/logo-bg.svg" alt="" />
    </div>
    <div class="navbar-logo-layer layer-2">
      <img src="/logo-bg.svg" alt="" />
    </div>
    <div class="navbar-logo-layer layer-3">
      <img src="/logo-bg.svg" alt="" />
    </div>
    <div class="navbar-logo-layer layer-4">
      <img src="/logo-bg.svg" alt="" />
    </div>
  </div>
</a>
