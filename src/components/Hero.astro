---
import { SITE_DESCRIPTION } from "@/constants";
import Logo from "@/components/shared/Logo.astro";
---

<section class="pt-10 pb-16 ml-10 flex items-center gap-xl">
  <Logo large />
  <div class="flex flex-col items-start">
    <h1 class="text-center pb-1">Ансин</h1>
    <p
      class="max-w-[35ch] text-foreground-muted font-serif text-md font-normal leading-[1.05]">
      {SITE_DESCRIPTION}
    </p>
  </div>
</section>
