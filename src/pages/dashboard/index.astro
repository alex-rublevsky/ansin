---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { getDashboardProducts } from "@/db/products/dashboard";
import AdminProductCard from "@/components/dashboard/AdminProductCard.astro";

const products = await getDashboardProducts();
---

<DashboardLayout title="Ансин — Админка">
  <main>
    <div
      class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4"
    >
      {
        products.map((product) => (
          <AdminProductCard
            title={product.name}
            slug={product.slug}
            images={[product.first_image, product.second_image].filter(
              (path): path is string =>
                typeof path === "string" && path.length > 0,
            )}
            price={product.price}
            isActive={product.isActive}
          />
        ))
      }
    </div>
  </main>
</DashboardLayout>
