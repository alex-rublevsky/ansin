---
interface Props {
  as?: "input" | "textarea";
  value?: string | number | null;
  name: string;
  id?: string;
  type?: "text" | "email" | "number" | "tel" | "password";
  placeholder?: string;
  label?: string;
  required?: boolean;
  pattern?: string;
  title?: string;
  error?: string;
  step?: number | string;
  readonly?: boolean;
  class?: string;
}

const {
  as = "input",
  value = "",
  name,
  id,
  type = "text",
  placeholder,
  label,
  required,
  pattern,
  title,
  error,
  step,
  readonly = false,
  class: className,
  ...rest
} = Astro.props as Props;

const inputId = id ?? `input-${name}`;
const hasLabel = !!label;
const hasError = !!error;
const isTextarea = as === "textarea";
---

<div
  class:list={[
    "input-wrapper",
    { "has-label": hasLabel, "has-error": hasError },
  ]}>
  {isTextarea ? (
    <textarea
      id={inputId}
      value={value}
      name={name}
      placeholder={hasLabel ? " " : placeholder}
      class:list={[
                    "input-field",
                    "textarea-field",
                   
                ]}      required={required || undefined}
      aria-invalid={hasError ? "true" : undefined}
      {...rest}
    />) : (
  <input
    id={inputId}
    value={value}
    name={name}
    type={type}
    placeholder={hasLabel ? " " : placeholder}
    class={className + " input-field"}
    required={required || undefined}
    pattern={pattern}
    title={title}
    aria-invalid={hasError ? "true" : undefined}
    step={step?.toString()}
    readonly={readonly}
    {...rest}
  />)}
  {
    hasLabel && (
      <label for={inputId} class="input-label">
        {label}
      </label>
    )
  }
  <span class="error-message input-error" role="alert">{error ?? ""}</span>
</div>

<style>
  /* .input-field[required] + .input-label {
    display: inline-flex;
    gap: 0.6ch;

    &::after {
      content: "*";
      font-size: var(--step--2);
      color: var(--muted);
    }
  } */

  .input-wrapper {
    position: relative;
    width: 100%;
    --input-height: 2.75rem;
  }

  .input-field {
    width: 100%;
    height: var(--input-height);
    padding-inline: 0.75rem;
    padding-block: 0.625rem;
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--foreground);
    font-size: inherit;
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s ease-out;
  }

  .input-field:hover {
    border-color: var(--muted);
  }

  .input-field::placeholder {
    color: var(--muted-foreground);
  }

  .input-field:focus {
    border-color: var(--foreground);
  }

  .has-label .input-field {
    padding-top: 1.125rem;
    padding-bottom: 0.25rem;
  }

  .textarea-field {
    height: auto;
    min-height: 6rem;
    resize: vertical;
  }


  .has-error .input-field,
  .has-error .input-field:focus {
    border-color: var(--destructive);
  }

  .input-error {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.75rem;
    color: var(--destructive);
  }

  .input-error:empty {
    display: none;
  }

  .input-label {
    pointer-events: none;
    position: absolute;
    left: 0.75rem;
    z-index: 1;
    /* Center on the input height, not the whole wrapper (error text sits below) */
    top: calc(var(--input-height) / 2);
    transform: translateY(-50%);
    color: var(--muted-foreground);
    font-size: 1em;
    transition:
      top 0.25s ease-out,
      transform 0.25s ease-out,
      font-size 0.25s ease-out,
      color 0.25s ease-out,
      padding-inline 0.25s ease-out,
      background-color 0.25s ease-out;
  }

  .textarea-field + .input-label {
    top: 1.375rem;
  }

  .input-field:focus + .input-label,
  .input-field:not(:placeholder-shown) + .input-label {
    top: 0;
    transform: translateY(-50%);
    font-size: 0.75rem;
    color: var(--foreground);
    background-color: var(--background);
    padding-inline: 0.25rem;
  }

  .has-error .input-field:focus + .input-label,
  .has-error .input-field:not(:placeholder-shown) + .input-label {
    color: var(--destructive);
  }

  @media (prefers-reduced-motion: reduce) {
    .input-label {
      transition: none;
    }
  }
</style>
