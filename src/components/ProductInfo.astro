---
import { ADMIN_STOREFRONT_FLAG_KEY } from "@/constants";
import { toProductPickerInit } from "@/lib/product-picker";
import { Icon } from "astro-icon/components";

interface Props {
  id: string | number;
  slug: string;
  image: string | null;
  name: string;
  category: { name: string; slug: string };
  volume: number;
  cakeVolume: number;
  variations: { id: number; weight: number; price: number }[];
  description: string;
}

const {
  id,
  slug,
  image,
  name,
  category,
  volume,
  cakeVolume,
  variations,
  description,
} = Astro.props;

import Badge from "@/components/shared/Badge.astro";
import Button from "@/components/shared/Button.astro";
import QuantityStepper from "@/components/shared/QuantitySelector.astro";
import VariationPicker from "@/components/shared/VariationPicker.astro";

const pickerInit = toProductPickerInit({
  id,
  slug,
  name,
  image: image ?? "",
  volume,
  cakeVolume,
  variations,
});

const editHref = `/dashboard/product/${slug}`;
---

<div
  class="px-(--space-2xs) mx-auto lg:max-w-[55ch] lg:pl-0 lg:pr-5 lg:py-5"
  x-data={`productPicker(${JSON.stringify(pickerInit)})`}>
  <div class="flex flex-wrap items-center gap-2">
  <a href={`/?category=${category.slug}`}>
    <Badge size="large">{category.name}</Badge>
    </a>
    <h1 class="text-lg! leading-[1.35]">{name}</h1>
  </div>

  <div class="mt-2 flex flex-wrap items-center gap-2">
    <p
      class="font-serif text-lg font-light"
      x-show="!allInCart"
      x-text="displayPrice">
    </p>
    <a href="/checkout" x-show="allInCart" x-cloak>
      <Badge variation="gray" size="large">Уже в корзине</Badge>
    </a>
    <Button
      variant="primary"
      size="square"
      href={editHref}
      x-cloak
      {...{
        "x-show": `!!localStorage.getItem(${JSON.stringify(ADMIN_STOREFRONT_FLAG_KEY)})`,
      } as any}>
      <Icon name="edit" title="Изменить" />
    </Button>
  </div>

  <div class="mt-4 flex flex-col gap-4">
    {variations.length > 0 && <VariationPicker />}

    <div class="flex flex-wrap items-center gap-2">
      <QuantityStepper size="lg" />
      <Button @click="addToCart()" {...{ ":disabled": "!canAdd" } as any}>
        В корзину
      </Button>
    </div>
  </div>

  <div class="mt-6">
    <div class="max-w-[55ch] [&_p]:text-base" set:html={description} />
  </div>
</div>
