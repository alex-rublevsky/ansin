---
import Badge from "@/components/shared/Badge.astro";
import Button from "@/components/shared/Button.astro";
import VariationPicker from "@/components/shared/VariationPicker.astro";
import { ADMIN_STOREFRONT_FLAG_KEY, BASE_IMAGE_URL } from "@/constants";
import { toProductPickerInit } from "@/lib/product-picker";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

const { product } = Astro.props;

if (!product) {
  return null;
}

const { images } = product;

const pickerInit = toProductPickerInit(
  {
    id: product.id,
    slug: product.slug,
    name: product.name,
    image: images.length > 0 ? BASE_IMAGE_URL + images[0] : "",
    volume: product.volume,
    cakeVolume: product.cakeVolume,
    variations: product.variations,
    discountedPrice: product.discountedPrice,
  },
  { mode: "quickAdd" },
);
---

<a
  class="productCard"
  href={`/product/${product.slug}`}
  data-product-slug={product.slug}
  data-product-id={product.id}
  x-data={`productPicker(${JSON.stringify(pickerInit)})`}>
  <div class="productImageWrapper" data-image-container>
    <div class="productImage relative aspect-square">
      {
        images.length > 0 ? (
          <>
            <div data-image-wrapper="0" class="absolute inset-0 bg-background">
              <Image
                src={BASE_IMAGE_URL + images[0]}
                width={500}
                height={500}
                alt={product.name}
                loading="lazy"
                class="h-full w-full object-cover object-center select-none"
                data-image-index="0"
              />
            </div>
            {images.length > 1 ? (
              <div
                data-image-wrapper="1"
                class="productCardSecondImage absolute inset-0 bg-background opacity-0">
                <Image
                  src={BASE_IMAGE_URL + images[1]}
                  width={500}
                  height={500}
                  alt=""
                  loading="lazy"
                  class="h-full w-full object-cover object-center select-none"
                  data-image-index="1"
                />
              </div>
            ) : null}
          </>
        ) : (
          <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
            <Icon
              name="image"
              title="Нет изображения"
              class="size-16 text-muted-foreground"
            />
          </div>
        )
      }
    </div>

    <Button
      variant="tertiary"
      size="square"
      class="editProductButton"
      x-cloak
      {...{
        "x-show": `!!localStorage.getItem(${JSON.stringify(ADMIN_STOREFRONT_FLAG_KEY)})`,
        "@click.prevent.stop": `window.location.assign(${JSON.stringify(`/dashboard/product/${product.slug}`)})`,
      } as any}>
      <Icon name="edit" title="Изменить" />
    </Button>

    <Button
      @click.prevent.stop="addToCart()"
      class="addToCartButton"
      variant="primary"
      size="square"
      {...{ ":disabled": "!canAdd" } as any}>
      <Icon name="cart" title="Корзина" />
    </Button>
  </div>

  <div class="flex gap-2xs">
    <p class="font-serif text-md font-light px-2 pt-1 pb-0" x-show="!allInCart" x-text="displayPrice">
    </p>
    <Badge x-show="allInCart" class="mx-2 mt-1.5" x-cloak>Уже в корзине</Badge>
    {
      product.discountedPrice ? (
        <p class="line-through" x-show="!allInCart">
          {product.discountedPrice}
        </p>
      ) : null
    }
  </div>

  <p class="text-sm lg:text-xs pt-0.5 pb-1 px-2">{product.name}</p>

  <VariationPicker size="sm" class="px-1" />
</a>

<style>
  .addToCartButton,
  .editProductButton {
    position: absolute;
    opacity: 1;
    z-index: 2;
  }

  .addToCartButton {
    bottom: 0.4rem;
    right: 0.4rem;
  }

  .editProductButton {
    top: 0.4rem;
    right: 0.4rem;
  }

  /* Hover-capable devices: hide until card hover. Touch: always visible. */
  @media (hover: hover) {
    .addToCartButton,
    .editProductButton {
      opacity: 0;
    }

    .addToCartButton {
      transform: translateY(0.4rem);
    }

    .editProductButton {
      transform: translateY(-0.4rem);
    }

    .addToCartButton:disabled {
      opacity: 0;
    }

    .productCardSecondImage {
      display: block;
      transition: opacity 240ms ease-out;
    }

    .productCard:hover .productCardSecondImage {
      opacity: 1;
    }

    .productCard:hover .addToCartButton,
    .productCard:hover .editProductButton {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .productCard {
    display: block;
    transition: transform 70ms ease-out;
    z-index: 1;
  }

  .productCard:active:not(:has(button:active)) {
    transform: scale(0.97);
  }
</style>
