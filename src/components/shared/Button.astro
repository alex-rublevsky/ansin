---
import { Icon } from "astro-icon/components";
import type { HTMLAttributes } from "astro/types";

type Variant =
  | "primary"
  | "secondary"
  | "tertiary"
  | "pill"
  | "destructive"
  | "editorTool";

type Size = "default" | "xs" | "sm" | "lg" | "square" | "categoryFilter";

type Props = Omit<
  HTMLAttributes<"button">,
  keyof {
    variant?: Variant;
    size?: Size;
    href?: string;
    withIcon?: boolean;
  }
> & {
  variant?: Variant;
  size?: Size;
  href?: string;
  name?: string;
  title?: string;
  /** Set when the slot is icon + text so they align with gap; Astro cannot infer this from the slot. */
  withIcon?: boolean;
};

const {
  variant,
  size,
  href,
  type,
  name,
  title,
  withIcon = false,
  class: className,
  ...rest
} = Astro.props;

const resolvedVariant = variant ?? "primary";

/** Icon + label row (opt-in via `leadingIcon`). */
const layoutClasses =
  withIcon && resolvedVariant !== "editorTool"
    ? "inline-flex items-center justify-center gap-2 [&_svg]:pointer-events-none [&_svg]:shrink-0"
    : "";

const baseClasses =
  "inline-flex cursor-pointer items-center justify-center gap-2 whitespace-nowrap rounded-md transition-all duration-200 ease-out disabled:cursor-not-allowed disabled:opacity-80 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-foreground [&_*]:text-inherit [&_svg]:pointer-events-none [&_svg]:shrink-0";

const variantClasses: Record<Variant, string> = {
  primary:
    "border-(length:--border-width) border-foreground bg-foreground text-background hover:bg-background hover:text-foreground active:scale-[0.97] active:bg-foreground active:text-background",
  secondary:
    "border-(length:--border-width) border-foreground bg-transparent text-foreground hover:bg-foreground hover:text-background active:bg-foreground active:text-background",
  tertiary:
    "border-(length:--border-width) border-foreground/15 bg-background/70 text-foreground backdrop-blur-sm hover:bg-foreground hover:text-background active:bg-foreground active:text-background disabled:border-muted/60 disabled:bg-muted/70 disabled:text-muted-foreground hover:disabled:bg-muted",
  pill: "text-foreground rounded-full hover:bg-[color-mix(in_oklch,var(--muted)_50%,var(--background))] active:bg-muted-foreground data-[active]:bg-foreground data-[active]:text-background data-[active]:border-foreground",
  destructive: "bg-destructive text-destructive-foreground",
  editorTool:
    "flex items-center justify-center box-border size-[1.875rem] shrink-0 border-0 p-0 rounded-lg bg-transparent text-xs font-bold leading-none text-foreground transition-[background-color,color] ease-out hover:bg-foreground/10 active:bg-foreground/30 disabled:opacity-30 disabled:cursor-default [&.is-active]:bg-foreground [&.is-active]:text-background [&_svg]:pointer-events-none [&_svg]:block [&_svg]:size-4 [&_svg]:stroke-current [&_svg]:fill-none [&_svg]:[stroke-width:2] [&_svg]:[stroke-linecap:round] [&_svg]:[stroke-linejoin:round]",
};

const sizeClasses: Record<Size, string> = {
  default: "h-11 px-4 py-3 text-sm",
  sm: "h-9 px-3 py-1 text-sm",
  categoryFilter: "px-2 pt-0.5 pb-0.5 radius-md text-sm",
  square: "aspect-square p-0.5 text-sm",
  xs: "px-0.5 px-1 py-0 text-xs",
  lg: "h-12 px-6 text-base! font-normal [&_svg]:size-6",
};

const variantClass = variantClasses[resolvedVariant];
const sizeClass =
  resolvedVariant === "editorTool" ? "" : sizeClasses[size ?? "default"];
const composedClass = `${baseClasses}${layoutClasses ? ` ${layoutClasses}` : ""}${variantClass ? ` ${variantClass}` : ""}${sizeClass ? ` ${sizeClass}` : ""}${className ? ` ${className}` : ""}`;
---

{
  href ? (
    <a href={href} class={composedClass} {...rest}>
      <slot />
    </a>
  ) : variant === "editorTool" ? (
    <button type="button" class={composedClass} {...rest}>
      {Astro.slots.has("default") ? (
        <slot />
      ) : name ? (
        <Icon name={name} title={title} />
      ) : null}
    </button>
  ) : (
    <button type={type ?? "button"} class={composedClass} {...rest}>
      <slot />
    </button>
  )
}
