---
import Button from "@/components/shared/Button.astro";

const pathname = Astro.url.pathname;

const dashboardNavItems = [
  { label: "Товары", href: "/dashboard", match: "exact" as const },
  { label: "Заказы", href: "/dashboard/orders", match: "prefix" as const },
  {
    label: "Аналитика",
    href: "/dashboard/analytics",
    match: "prefix" as const,
  },
];

const isActive = (href: string, match: "exact" | "prefix") =>
  match === "exact"
    ? pathname === href
    : pathname === href || pathname.startsWith(`${href}/`);

const isDashboardFeedPage = pathname === "/dashboard";
---

<nav class="fixed bottom-1.5 left-1.5 right-1.5 z-999 flex gap-3xs items-center">
  <div class="navElementWrapper">
    {
      dashboardNavItems.map((item) => (
        <Button
          size="categoryFilter"
          href={item.href}
          variant="pill"
          data-active={isActive(item.href, item.match) ? "" : undefined}
        >
          {item.label}
        </Button>
      ))
    }
  </div>
  {
    isDashboardFeedPage && (
      <Button size="sm" href="/dashboard/product/new">
        Создать товар
      </Button>
    )
  }
</nav>
