---
import PillButtonGroup from "@/components/shared/PillButtonGroup.astro";

const dashboardNavItems = [
  { label: "Товары", href: "/dashboard", match: "exact" as const },
  { label: "Заказы", href: "/dashboard/orders", match: "prefix" as const },
  {
    label: "Категории",
    href: "/dashboard/categories",
    match: "prefix" as const,
  },
];
---

<nav class="fixed bottom-0 left-0 right-0 z-999">
  <PillButtonGroup items={dashboardNavItems} />
</nav>
