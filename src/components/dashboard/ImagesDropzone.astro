---
import { BASE_IMAGE_URL } from "@/constants";
import { Image } from "astro:assets";
import Button from "@/components/shared/Button.astro";
import { Icon } from "astro-icon/components";

const { images } = Astro.props;
---

<div id="drop-area" data-initial-images={JSON.stringify(images)}>
  <div id="gallery">
    {
      images.map((image: string) => (
        <div
          class="productImage relative group cursor-grab"
          data-path={image}
          data-status="ready">
          <Button
            type="button"
            data-action="remove"
            class="opacity-0 group-hover:opacity-100 transition-opacity duration-200 ease-out absolute top-0 right-0 z-999"
            size="square">
            <Icon name="x" title="Удалить" />
          </Button>
          <Image
            src={`${BASE_IMAGE_URL}${image}`}
            alt=""
            width={300}
            height={300}
            data-role="preview"
          />
          <div class="tileSpinner" role="status">
            <Icon
              name="spinner"
              title="Загрузка"
              class="size-8 animate-spin"
            />
            <span class="sr-only">Загрузка...</span>
          </div>

          <div class="tileError" aria-hidden="true" />
        </div>
      ))
    }

    <label id="add-photo-button" for="image_uploads" class="addItemEntry">
      <span class="plus">+</span>
      <span>Добавить фото</span>
    </label>

    <input
      hidden
      class="addItemEntry"
      type="file"
      id="image_uploads"
      multiple
      accept="image/*"
    />
  </div>

  <label class="text-sm text-center text-muted pt-2 pb-1 select-none"
    >Фотки можно перетащить сюда</label
  >
</div>

<template id="image-tile-template">
  <div class="productImage relative group cursor-grab">
    <Button
      type="button"
      data-action="remove"
      class="opacity-0 group-hover:opacity-100 transition-opacity duration-200 ease-out absolute top-0 right-0 z-999"
      size="square">
      <Icon name="x" title="Удалить" />
    </Button>
    <img alt="" data-role="preview" />
    <div class="tileSpinner" role="status">
      <Icon
        name="spinner"
        title="Загрузка"
        class="size-8 animate-spin"
      />
      <span class="sr-only">Загрузка...</span>
    </div>
    <div class="tileError" aria-hidden="true"></div>
  </div>
</template>

<style>
  #drop-area {
    display: flex;
    flex-direction: column;
    border: var(--border-width) dashed var(--border);
    /*border-radius: var(--radius-lg);*/
    width: 100%;
    padding: 0.4rem;
  }

  #drop-area.highlight {
    border-color: purple;
  }

  #gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(6rem, 1fr));
    gap: 0.5rem;
  }

  .productImage img,
  .addItemEntry {
    width: 100%;
    aspect-ratio: 1;
    user-select: none;
  }

  .productImage {
    position: relative;
    border: var(--border-width) solid var(--border);
  }

  .productImage img {
    display: block;
    object-fit: cover;
    transition:
      opacity 170ms ease-out,
      filter 170ms ease-out,
      transform 0.3s ease-out;
  }

  .addItemEntry {
    padding: 0.2rem;
    text-align: center;
    line-height: 1;
    display: flex;
    gap: 1rem;
    font-size: var(--step--1);
    flex-direction: column;
    justify-content: center;
    align-items: center;
    border: var(--border-width) dashed var(--border);
    cursor: pointer;
    transition:
      border-color 170ms,
      transform 170ms;
  }

  .addItemEntry:hover {
    border-color: var(--primary);
  }
  .addItemEntry:active {
    transform: scale(0.97);
  }

  .addItemEntry .plus {
    font-size: var(--step-2);
    font-weight: 100;
    line-height: 0;
    color: var(--muted);
    transition:
      transform 170ms ease-out,
      color 170ms ease-out;
  }

  .addItemEntry:hover .plus {
    transform: scale(1.15);
    color: var(--foreground);
  }

  /* Per-tile upload state overlays. Only one of these is visible at a time,
     driven by the `data-status` attribute set from dropzone-gallery.ts. */
  .tileSpinner,
  .tileError {
    display: none;
    position: absolute;
    inset: 0;
    align-items: center;
    justify-content: center;
  }

  .productImage[data-status="uploading"] {
    cursor: wait;
  }

  .productImage[data-status="uploading"] img {
    opacity: 0.5;
    filter: grayscale(0.4);
  }

  .productImage[data-status="uploading"] .tileSpinner {
    display: flex;
  }

  .productImage[data-status="error"] img {
    opacity: 0.35;
  }

  .productImage[data-status="error"] .tileError {
    display: flex;
  }

  .tileError {
    background: color-mix(in oklch, var(--destructive) 15%, transparent);
  }

  .tileError::after {
    content: "!";
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--destructive);
    color: var(--destructive-foreground);
    font-size: var(--step--1);
    font-weight: 700;
    line-height: 1;
  }
</style>

<script>
  import "@/lib/dropzone-gallery";
</script>
