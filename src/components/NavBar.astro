---
import Logo from "@/components/shared/Logo.astro";
import CategoryFilter from "@/components/CategoryFilter.astro";
import CartButton from "@/components/CartButton.astro";
const isHomePage = Astro.url.pathname === "/";
---

<nav
  class="site-nav fixed bottom-3 left-3 right-3 z-999 flex items-end justify-between gap-2">
  <div class="shrink-0">
    <Logo />
  </div>
  {
    isHomePage && (
      <div class="min-w-0 flex-1 self-end">
        <CategoryFilter />
      </div>
    )
  }
  <div class="shrink-0">
    <CartButton />
  </div>
</nav>
