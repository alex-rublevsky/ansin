---
import Button from "@/components/shared/Button.astro";
import { listStorefrontCategories } from "@/db/storefront/listCategories";

const categories = await listStorefrontCategories();

const items = [
  { label: "Все", value: "all" },
  ...categories.map((cat) => ({
    label: cat.name,
    value: cat.slug,
  })),
];

---

<div class="navElementWrapper flex w-full min-w-0 flex-wrap items-center justify-center gap-1 md:justify-start">
  {
    categories.length > 0 &&
      items.map((cat) => (
        <Button
          href={cat.value === "all" ? "/" : `/?category=${cat.value}`}
          size="categoryFilter"
          variant="pill"
          data-filter-btn=""
          data-value={cat.value}>
          {cat.label}
        </Button>
      ))
  }
</div>
